APP_NAME=Gastos API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Required for persistence and authentication.
MONGODB_URI=
MONGODB_DATABASE=

# Required for access and refresh tokens. Use a long random secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Required only when running either initial seed.
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=

# Used by `python -m scripts.seed_data` for the initial test account.
INITIAL_ACCOUNT_NAME=Main account
INITIAL_ACCOUNT_CURRENCY=COP
INITIAL_ACCOUNT_BALANCE=1000000.00

EXCHANGE_RATE_PROVIDER=
EXCHANGE_RATE_API_KEY=
