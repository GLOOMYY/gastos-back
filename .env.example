APP_NAME=Gastos API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Required for persistence and authentication.
MONGODB_URI=
MONGODB_DATABASE=

# Required for access and refresh tokens. Use a long random secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

EXCHANGE_RATE_PROVIDER=
EXCHANGE_RATE_API_KEY=
